---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="app-layout flex flex-1 items-start">
    <div>
      <h1 class="heading-1">Page not found</h1>
      <p class="mt-3 text-subtle">
        The page you asked for is not here. It may have moved, or never existed.
      </p>
      <a href="/" class="mt-8 inline-block meta hover:text-accent">
        &larr; Back home
      </a>
    </div>
  </main>

  <Footer />
</Layout>
