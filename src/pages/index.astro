---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import postFilter from "@/utils/postFilter";
import { SITE } from "@/config";

const posts = await getCollection("blog", postFilter);
const recentPosts = getSortedPosts(posts).slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <p class="max-w-[34rem] text-pretty">{SITE.desc}</p>

    <section id="recent-posts" class="mt-12 sm:mt-16">
      <h2 class="nav-text text-subtle">Recent</h2>
      <ul>
        {recentPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
      <a href="/posts/" class="nav-text text-subtle hover:text-accent"
        >All posts &rarr;</a
      >
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
