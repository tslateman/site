---
type StringTitle = { pageTitle: string };
type ArrayTitle = { pageTitle: [string, string]; titleTransition: string };

type Props = (StringTitle | ArrayTitle) & { pageDesc?: string };

const { props } = Astro;
---

<main id="main-content" class="app-layout">
  {
    "titleTransition" in props ? (
      <h1 class="heading-1 text-balance">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="heading-1 text-balance">{props.pageTitle}</h1>
    )
  }
  {
    props.pageDesc && (
      <p class="mt-2 text-pretty text-subtle">{props.pageDesc}</p>
    )
  }
  <div class="mt-10"><slot /></div>
</main>
