---
import type { HTMLAttributes } from "astro/types";
import { SOCIALS } from "@/constants";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const links = [
  { href: "/archives", label: "Archive" },
  { href: "/rss.xml", label: "RSS" },
  ...SOCIALS.map(({ name, href }) => ({ href, label: name })),
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="mt-16 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t border-border py-8 meta"
  >
    <span>&#169; {currentYear} {SITE.author}</span>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="hover:text-accent">
              {label}
            </a>
          </li>
        ))
      }
      {
        SITE.lightAndDarkMode && (
          <li>
            <button id="theme-btn" aria-live="polite" class="hover:text-accent">
              <span class="dark:hidden">Dark</span>
              <span class="hidden dark:inline">Light</span>
            </button>
          </li>
        )
      }
    </ul>
  </div>
</footer>
