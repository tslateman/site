---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import getReadingTime from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, body, filePath } = Astro.props;

const { title, description, ...props } = data;
---

<li class="my-8 first:mt-6">
  <Heading
    class="heading-2 text-balance"
    style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
  >
    <a href={getPath(id, filePath)} class="hover:text-accent">{title}</a>
  </Heading>
  <Datetime
    {...props}
    readingTime={body ? getReadingTime(body) : undefined}
    class="mt-1"
  />
  <p class="mt-2 text-pretty text-subtle">{description}</p>
</li>
