---
type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "hover:text-accent",
      { meta: size === "sm" },
      { "text-base": size === "lg" },
    ]}
  >
    {tagName}
  </a>
</li>
