---
import { SITE } from "@/config";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/tags", label: "Tags" },
  { href: "/about", label: "About" },
  { href: "/search", label: "Search" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-6 -top-full z-50 bg-background px-3 py-2 text-accent transition-all focus:top-4"
>
  Skip to content
</a>

<header class="app-layout">
  <div
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-8 pb-9 sm:pt-12 sm:pb-12"
  >
    <a href="/" class="nav-text hover:text-accent">{SITE.author}</a>
    <nav>
      <ul class="flex gap-x-5 meta">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "hover:text-accent",
                  {
                    "text-foreground underline decoration-border underline-offset-4":
                      isActive(href),
                  },
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
