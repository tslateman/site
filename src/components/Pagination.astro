---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="app-layout mt-12 flex items-baseline justify-between meta"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      {page.url.prev ? (
        <a
          href={page.url.prev}
          aria-label="Goto Previous Page"
          class="hover:text-accent"
        >
          &larr; Newer
        </a>
      ) : (
        <span class="opacity-0">&larr; Newer</span>
      )}
      <span>
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a
          href={page.url.next}
          aria-label="Goto Next Page"
          class="hover:text-accent"
        >
          Older &rarr;
        </a>
      ) : (
        <span class="opacity-0">Older &rarr;</span>
      )}
    </nav>
  )
}
